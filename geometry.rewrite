% rewrite geometry {
  main [item+] = ‛«item»’
  item_geometry [g] = ‛«g»’
  item_default [c] = ‛«c»’
  geometry [_geo ws1 _colon ws5 lb ws2 x y w h as? rect? rb ws3  _comma ws4] = ‛\n«_geo»«ws1»«_colon»«ws5»«lb»«ws2»«x»«y»«w»«h»«as»«rect»«rb»«ws3»«_comma»«ws4»’
  x [_ ws1 _colon ws2 n _comma ws3] = ‛«n»’
  y [_ ws1 _colon ws2 n _comma ws3] = ‛«n»’
  width [_ ws1 _colon ws2 n _comma ws3] = ‛«n»’
  height [_ ws1 _colon ws2 n _comma ws3] = ‛«n»’
  as [_ ws1 _colon ws2 s _comma ws3] = ‛’
  rectangle [_ ws1 _colon ws2 lb ws3 cs* rb ws4] = ‛’
  string [ldq cs* rdq ws] = ‛«ldq»«cs»«rdq»«ws»’
  number [sign? fdigit+ ws] = ‛«sign»«fdigit»«ws»’
  sign [c] = ‛«c»’
  fdigit [c] = ‛«c»’
  dq [c] = ‛«c»’
  str [dq s dq2] = ‛«dq»«s»«dq2»’
  ws [x] = ‛«x»’
  space [c] = ‛«c»’
  spaces [cs*] = ‛«cs»’
}
