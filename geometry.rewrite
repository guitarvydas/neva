  main [item+] = ‛«item»’
  item_geometry [g] = ‛«g»’
  item_default [c] = ‛«c»’
  geometry [_geo ws1 lb ws2 x y w h as? rect? rb ws3  _comma ws4] = ‛\n«_geo»«ws1»«lb»«ws2»«x»«y»«w»«h»«as»«rect»«rb»«ws3»«_comma»«ws4»’
  x [_ ws1 _colon ws2 n _comma ws3] = ‛«_»«ws1»«_colon»«ws2»«n»«_comma»«ws3»’
  y [_ ws1 _colon ws2 n _comma ws3] = ‛«_»«ws1»«_colon»«ws2»«n»«_comma»«ws3»’
  width [_ ws1 _colon ws2 n _comma ws3] = ‛«_»«ws1»«_colon»«ws2»«n»«_comma»«ws3»’
  height [_ ws1 _colon ws2 n _comma ws3] = ‛«_»«ws1»«_colon»«ws2»«n»«_comma»«ws3»’
  as [_ ws1 _colon ws2 s _comma ws3] = ‛«_»«ws1»«_colon»«ws2»«s»«_comma»«ws3»’
  rectangle [_ ws1 _colon ws2 lb ws3 cs* rb ws4] = ‛«_»«ws1»«_colon»«ws2»«lb»«ws3»«cs»«rb»«ws4»’
  string [ldq cs* rdq ws] = ‛«ldq»«cs»«rdq»«ws»’
  number [sign? fdigit+ ws] = ‛«sign»«fdigit»«ws»’
  sign [c] = ‛«c»’
  fdigit [c] = ‛«c»’
  dq [c] = ‛«c»’
